<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MayBox | Vos offres Internet</title>
    <link href="/css/style.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet"> 
    /* Import de la police Poppins depuis Google Fonts pour une typographie moderne et élégante */
</head>
<body>

<%- include('navbar') -%>

    <header>
        <h1>MayBox</h1> 
        <div class="user-status">
            <% if (nomClient) { %>
                <p class="you">👋 Ravi de vous revoir, <strong><%= nomClient %></strong> !</p>
                <br>
                <a href="/api/logout" class="btn-logout">Se déconnecter</a>
            <% } else { %>
                <p class="you">Bienvenue ! Connectez-vous pour profiter de nos offres.</p>
            <% } %>
        </div>
    </header>

    <% if (!nomClient) { %>
    <section class="container-auth">
        <div class="auth-container">
            <div class="auth-card">
                <h3>Créer un compte</h3>
                <form action="/api/client" method="POST">
                    <input type="text" name="nom" placeholder="Nom complet" required>
                    <input type="email" name="email" placeholder="Email" required>
                    <input type="password" name="mot_de_passe" placeholder="Mot de passe" required>
                    <button type="submit" class="btn-primary">S'inscrire</button>
                </form>
            </div>

            <div class="auth-card">
                <h3>Déjà client ?</h3>
                <form action="/api/login" method="POST">
                    <input type="email" name="email" placeholder="Email" required>
                    <input type="password" name="password" placeholder="Mot de passe" required>
                    <button type="submit" class="btn-secondary">Connexion</button>
                </form>
            </div>
        </div>
    </section>
    <% } %>

    <main class="container-offers">
        <section id="offres">
            <h2 class="section-title">Choisissez votre abonnement</h2>
            
            <div class="grid-offres">

                <div class="carte-box">
                    <div class="box-img-wrapper">
                        <img src="/images/starter.png" alt="Box Starter" class="box-img">
                    </div>
                    <div class="box-content">
                        <h3>Box Starter</h3>
                        <p class="price">19.99€ <span>/ mois</span></p>
                        <p class="desc">L'essentiel de la fibre, sans superflu. Une connexion stable pour tous vos besoins quotidiens.</p>
                        <form action="/api/souscrire" method="POST">
                            <input type="hidden" name="id_box" value="1">
                            <button type="submit" class="btn-buy">Souscrire</button>
                        </form>
                    </div>
                </div>

                <div class="carte-box featured">
                    <div class="box-img-wrapper">
                        <img src="/images/premium.png" alt="Box Premium" class="box-img">
                    </div>
                    <div class="box-content">
                        <span class="badge">Le plus populaire</span>
                        <h3>Box Premium</h3>
                        <p class="price">29.99€ <span>/ mois</span></p>
                        <p class="desc">Le meilleur débit avec plus de 200 chaînes TV incluses. Parfait pour la famille.</p>
                        <form action="/api/souscrire" method="POST">
                            <input type="hidden" name="id_box" value="2">
                            <button type="submit" class="btn-buy">Souscrire</button>
                        </form>
                    </div>
                </div>

                <div class="carte-box">
                    <div class="box-img-wrapper">
                        <img src="/images/ultra.png" alt="Box Ultra" class="box-img">
                    </div>
                    <div class="box-content">
                        <h3>Box Ultra</h3>
                        <p class="price">39.99€ <span>/ mois</span></p>
                        <p class="desc">Vitesse fulgurante 8Gb/s et tous vos services de streaming préférés inclus.</p>
                        <form action="/api/souscrire" method="POST">
                            <input type="hidden" name="id_box" value="3">
                            <button type="submit" class="btn-buy">Souscrire</button>
                        </form>
                    </div>
                </div>

            </div>
        </section>
    </main>

</body>
</html>